<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Hallow Browser - the "Hallow console" look: the family's dark purple-black, the Hallow accent (#F07820 here is swapped for
         the theme.json accent, also in its #AARRGGBB forms; #F59A50 = a lighter accent; #1A0E04 = text on the accent) and lilac
         secondaries. EVERY colour of the browser's own chrome is a resource here, so a light theme is one more dictionary. -->
    <SolidColorBrush x:Key="Bg" Color="#14101B"/>
    <SolidColorBrush x:Key="Strip" Color="#110E17"/>
    <SolidColorBrush x:Key="Bar" Color="#1C1726"/>
    <SolidColorBrush x:Key="Panel" Color="#1C1726"/>
    <SolidColorBrush x:Key="PanelHi" Color="#2A2336"/>
    <SolidColorBrush x:Key="TabOn" Color="#1C1726"/>
    <SolidColorBrush x:Key="TabHover" Color="#1A1522"/>
    <SolidColorBrush x:Key="FieldBg" Color="#110E17"/>
    <SolidColorBrush x:Key="FieldFocus" Color="#0E0B13"/>
    <SolidColorBrush x:Key="Line" Color="#3A3248"/>
    <SolidColorBrush x:Key="LineDim" Color="#2A2336"/>
    <SolidColorBrush x:Key="Text" Color="#ECE8F4"/>
    <SolidColorBrush x:Key="Muted" Color="#9790A8"/>
    <SolidColorBrush x:Key="Lilac" Color="#A98BE0"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#F07820"/>
    <SolidColorBrush x:Key="AccentLight" Color="#F59A50"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#33F07820"/>
    <SolidColorBrush x:Key="AccentGlow" Color="#80F07820"/>
    <SolidColorBrush x:Key="OnAccent" Color="#1A0E04"/>
    <SolidColorBrush x:Key="Green" Color="#6ED28C"/>
    <SolidColorBrush x:Key="Amber" Color="#F0BE5A"/>
    <SolidColorBrush x:Key="Red" Color="#E05A64"/>
    <SolidColorBrush x:Key="CloseHover" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Rail" Color="#110E17"/>
    <SolidColorBrush x:Key="BadgeBg" Color="#D13C48"/>
    <Color x:Key="PageBg">#14101B</Color>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" Stroke="#F07820" StrokeThickness="1.5" RadiusX="3" RadiusY="3" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- buttons: squared, thin border, the accent on hover -->
    <Style x:Key="Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="#1E1829"/>
        <Setter Property="BorderBrush" Value="#463C58"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"/>
                        <Border x:Name="hl" Background="#F07820" Opacity="0" CornerRadius="3"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.10"/><Setter TargetName="b" Property="BorderBrush" Value="#F07820"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="hl" Property="Opacity" Value="0.2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#33F07820"/><Setter TargetName="b" Property="BorderBrush" Value="#F07820"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Accent" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="#33F07820"/>
        <Setter Property="BorderBrush" Value="#F07820"/>
        <Setter Property="Foreground" Value="#F59A50"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>

    <!-- toolbar icon buttons: flat, a soft square on hover -->
    <Style x:Key="Tool" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource PanelHi}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#33F07820"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#33F07820"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- caption buttons (minimise / maximise / close) -->
    <Style x:Key="Caption" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource PanelHi}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="close"/></MultiTrigger.Conditions>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource CloseHover}"/><Setter Property="Foreground" Value="White"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- menu rows in the flyouts -->
    <Style x:Key="MenuRow" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource PanelHi}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource PanelHi}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the address bar and other fields -->
    <Style x:Key="Address" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="#F07820"/>
        <Setter Property="SelectionBrush" Value="#F07820"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="CaretBrush" Value="#F07820"/>
        <Setter Property="SelectionBrush" Value="#F07820"/>
        <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#F07820"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- on/off switches -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="track" Width="34" Height="18" CornerRadius="9" Background="#2A2336" BorderBrush="#463C58" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,10,0">
                            <Ellipse x:Name="knob" Width="12" Height="12" Fill="#9790A8" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Top"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="#33F07820"/><Setter TargetName="track" Property="BorderBrush" Value="#F07820"/>
                            <Setter TargetName="knob" Property="Fill" Value="#F07820"/><Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- thin scroll bars -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="#3A3248" CornerRadius="4" Margin="2"/></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#221C2E"/>
        <Setter Property="Foreground" Value="#ECE8F4"/>
        <Setter Property="BorderBrush" Value="#3A3248"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>
</ResourceDictionary>
